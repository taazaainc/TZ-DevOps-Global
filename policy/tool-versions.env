# Central version policy for the scanning tools. Changed only through a reviewed PR.
#
# Pinned versions (default): no GitHub API call per job (many parallel jobs hit GitHub's rate limit),
# and the download must match the SHA256 recorded here, which is stronger than the release's own
# checksum file. Hashes taken from the official release checksum files and cross-checked by download.
# To move to a newer release: update VERSION and SHA256 together in a PR (a scheduled bump job will
# open that PR automatically, using releases older than TOOL_COOLDOWN_DAYS).
#
# "latest" is still supported (newest stable release older than TOOL_COOLDOWN_DAYS) but calls the
# GitHub API in every job.
TOOL_COOLDOWN_DAYS=3

GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
GITLEAKS_MIN_VERSION=8.30.1

TRIVY_VERSION=0.76.2
TRIVY_SHA256=bc0fc726e017b8927a62b2d3531d7a84ee01769daf5c99ed866dced54089fdbf
TRIVY_MIN_VERSION=0.76.2
