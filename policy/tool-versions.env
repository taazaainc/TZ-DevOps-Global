# Central version policy for the scanning tools. Changed only through a reviewed PR.
# latest = newest stable release that is at least TOOL_COOLDOWN_DAYS old.
# To pin instead: set <TOOL>_VERSION=x.y.z and fill <TOOL>_SHA256 with the tarball's sha256.
TOOL_COOLDOWN_DAYS=3

GITLEAKS_VERSION=latest
GITLEAKS_MIN_VERSION=8.30.1

TRIVY_VERSION=latest
TRIVY_MIN_VERSION=0.76.2
